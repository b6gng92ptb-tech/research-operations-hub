MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0&directConnection=true
MONGODB_DB=research_operations
# Configure a real OIDC issuer (e.g. Cognito), client ID and audience; never commit secrets.
OIDC_ISSUER=https://example.auth.eu-west-1.amazoncognito.com
OIDC_AUDIENCE=your-app-client-id
OIDC_JWKS_URL=https://cognito-idp.eu-west-1.amazonaws.com/REGION_POOL_ID/.well-known/jwks.json
# Optional: external event webhook secret
WEBHOOK_SECRET=replace-with-random-32-character-secret

# Only enable in a trusted local development environment; public demo stays showcase-only.
NEXT_PUBLIC_ENABLE_LIVE_MODE=false
